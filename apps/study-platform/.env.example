NAVISTUDY_ENV=development
NAVISTUDY_DATA_DIR=./var
NAVISTUDY_PUBLIC_ORIGIN=http://127.0.0.1:8787
NAVISTUDY_ALLOWED_ORIGINS=http://127.0.0.1:8787,https://study.example.test,https://words.example.test,https://mt.example.test
NAVISTUDY_COOKIE_SECURE=0
NAVISTUDY_ANALYTICS_SECRET=replace-with-a-random-production-secret
