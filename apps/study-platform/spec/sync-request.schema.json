{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.example.test/schema/sync-request-v1.json",
  "type": "object",
  "required": ["deviceId", "baseRevision", "schemaVersion", "mutations"],
  "additionalProperties": false,
  "properties": {
    "deviceId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "schemaVersion": { "const": 1 },
    "mutations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["mutationId", "type"],
        "properties": {
          "mutationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
          "type": { "enum": ["merge_snapshot", "entity_upsert", "entity_delete", "event_append", "progress_set"] },
          "collection": { "type": "string" },
          "key": { "type": "string" },
          "value": {},
          "data": { "type": "object" }
        }
      }
    }
  }
}

