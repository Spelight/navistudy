<view class="page">
  <view class="appbar"><view><view class="appbar-title">NaviPlan</view><view class="appbar-sub">培养方案与毕业进度规划</view></view><button class="top-button" bindtap="goPassport">{{account ? account.username : '登录'}}</button></view>
  <view wx:if="{{snapshot}}">
    <view class="hero"><view class="hero-label">毕业还缺</view><view class="hero-value">{{summary.missing}}<text> 学分</text></view><view class="hero-copy"><text>{{snapshot.student.major}} · {{snapshot.student.grade}}级</text><text>总要求 {{snapshot.audit.totalRequiredCredits}} 学分，已获 {{summary.earned}}，在修/规划 {{summary.active}}</text></view></view>
    <view class="section-title">所缺学分</view><view class="list"><view wx:for="{{summary.gaps}}" wx:key="group.id" class="row"><view class="tag warning">缺 {{item.missingCredits}} 学分{{item.missingCourseCount ? ' / ' + item.missingCourseCount + ' 门' : ''}}</view><text class="strong">{{item.group.name}}</text><text>要求 {{item.group.requiredCredits}} · 已获 {{item.earnedCredits}} · 在修 {{item.inProgressCredits}} · 规划 {{item.plannedCredits}}</text></view></view>
    <view class="section-heading"><view class="section-title">未来未选必修</view><text>{{summary.futureRequired.length}} 门</text></view><view class="list"><view wx:for="{{futureRequired}}" wx:key="course.id" class="row"><view class="tag warning">{{item.course.status === 'FAILED' ? '未通过' : '必修'}}</view><text class="strong">{{item.course.courseName}}</text><text>{{item.course.courseCode || '代码待确认'}} · {{item.course.credits}} 学分 · {{item.course.displayTerm}}</text><text class="advice">{{item.course.advice}}</text></view></view>
    <view class="section-heading"><view class="section-title">限修 / 选修候选</view><text>{{summary.futureLimited.length}} 门可选</text></view><view class="list"><view wx:for="{{futureLimited}}" wx:key="course.id" class="row"><view class="tag">{{item.course.displayNature}}</view><text class="strong">{{item.course.courseName}}</text><text>{{item.course.courseCode || '代码待确认'}} · {{item.course.credits}} 学分 · {{item.course.displayTerm}}</text><text class="advice">{{item.course.advice}}</text></view></view>
    <button class="secondary-btn full-list-button" bindtap="goRequirements">查看完整课程清单</button>
  </view>
  <view wx:else class="panel empty">还没有培养方案快照。登录 NaviPassport 后，从“数据源”完成首次导入。</view>
</view>
<view class="module-tabbar"><navigator class="module-tab active" url="/plan/pages/index/index" open-type="redirect">概览</navigator><navigator class="module-tab" url="/plan/pages/requirements/requirements" open-type="redirect">培养方案</navigator><navigator class="module-tab" url="/plan/pages/courses/courses" open-type="redirect">课程</navigator><navigator class="module-tab" url="/plan/pages/source/source" open-type="redirect">数据源</navigator><navigator class="module-tab module-home" url="/pages/portal/portal" open-type="reLaunch">NaviStudy</navigator></view>
