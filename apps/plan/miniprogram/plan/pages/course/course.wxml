<view class="page"><view wx:if="{{course}}"><view class="appbar"><view><view class="appbar-title">{{course.courseName}}</view><view class="appbar-sub">{{course.courseCode || '代码待确认'}} · {{course.termName}}</view></view></view><view class="panel"><label class="field">修读状态<picker mode="selector" range="{{statuses}}" value="{{statusIndex}}" bindchange="changeStatus"><view class="picker">{{statuses[statusIndex]}}</view></picker></label><label class="field">要求类别<picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory"><view class="picker">{{categories[categoryIndex]}}</view></picker></label><label class="field">学分<input class="input" type="digit" value="{{credits}}" bindinput="changeCredits"/></label><label class="field">备注<textarea class="textarea" value="{{note}}" bindinput="changeNote"/></label><button class="primary-btn" style="margin-top: 24rpx" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存修正</button></view></view></view>
