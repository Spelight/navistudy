<view class="page theme-{{naviTheme}}"><view wx:if="{{stats}}"><view class="appbar"><view><view class="appbar-title">统计结果</view><view class="appbar-sub">{{stats.session.title}}</view></view><view class="tag">{{stats.session.totalResponses}} 人</view></view><view class="panel"><view class="section-title">大家都有空的时间</view><view class="section-meta" style="margin-top:8rpx">点击格子查看对应人员名单</view><scroll-view class="grid-scroll" scroll-x enhanced style="margin-top:20rpx"><view class="time-grid" style="{{gridStyle}}"><view class="grid-cell head">节次</view><view wx:for="{{stats.session.days}}" wx:for-item="day" wx:key="id" class="grid-cell head">{{day.label}}</view><block wx:for="{{stats.session.periods}}" wx:for-item="period" wx:key="id"><view class="grid-cell head"><text>{{period.label}}</text><text class="period-time">{{period.start}}</text></view><button wx:for="{{stats.session.days}}" wx:for-item="day" wx:key="id" class="grid-cell heat-{{cells[day.id + '-' + period.id].heat || 0}}" data-slot="{{day.id + '-' + period.id}}" bindtap="inspect">{{cells[day.id + '-' + period.id].count || 0}}</button></block></view></scroll-view></view><view class="section-head"><view class="section-title">提交记录</view><view class="section-meta">{{responses.length}} 条</view></view><view class="panel"><view wx:for="{{responses}}" wx:key="token" class="response" data-token="{{item.token}}" bindtap="editResponse"><text class="strong">{{item.respondentName || '未命名填写'}}</text><text>{{item.slots.length}} 个时段 · 点按可修改姓名</text></view><view wx:if="{{!responses.length}}" class="empty">还没有提交记录。</view></view><view class="actions"><button class="primary-btn" open-type="share">转发问卷</button><button class="secondary-btn" bindtap="copyLink">复制网页链接</button><button class="secondary-btn" bindtap="showQr">网页二维码</button><button class="secondary-btn" bindtap="edit">编辑问卷</button></view><button class="danger-btn" style="margin-top:12rpx" bindtap="remove">删除问卷</button></view><view wx:else class="panel empty">{{error || '正在读取统计...'}}</view><view wx:if="{{error && stats}}" class="error">{{error}}</view></view><view wx:if="{{qrDataUrl}}" class="qr-mask" bindtap="closeQr"><view class="qr-dialog" catchtap="noop"><text class="strong">网页填写二维码</text><text>长按识别或截图分享，扫码后无需登录即可填写。</text><image class="qr-image" src="{{qrDataUrl}}" mode="aspectFit" show-menu-by-longpress/><button class="secondary-btn" bindtap="closeQr">关闭</button></view></view>
