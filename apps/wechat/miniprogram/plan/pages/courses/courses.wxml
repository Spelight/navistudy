<view class="page theme-{{naviTheme}}"><view class="appbar"><view><view class="appbar-title">完整课程清单</view><view class="appbar-sub">{{visible}} / {{total}} 门 · 按培养方案课程组归类</view></view></view><input class="course-search" value="{{query}}" bindinput="onSearch" placeholder="搜索课程名称、代码、性质或课程组"/><block wx:for="{{groups}}" wx:key="label"><view class="section-heading"><view class="section-title">{{item.label}}</view><text>{{item.courses.length}} 门</text></view><view class="list"><button wx:for="{{item.courses}}" wx:key="id" wx:for-item="course" class="row" data-id="{{course.id}}" bindtap="openCourse"><view class="tag {{course.status === 'FAILED' ? 'warning' : ''}}">{{course.statusLabel}}</view><text class="strong">{{course.courseName}}</text><text>{{course.courseCode || '代码待确认'}} · {{course.courseNature || course.category}} · {{course.credits}} 学分</text><text>{{course.plannedTermName || course.termName}}</text></button></view></block><view wx:if="{{!groups.length}}" class="panel empty">没有匹配的课程。</view></view>
<view class="module-tabbar"><navigator class="module-tab" url="/plan/pages/index/index" open-type="redirect">概览</navigator><navigator class="module-tab" url="/plan/pages/requirements/requirements" open-type="redirect">培养方案</navigator><navigator class="module-tab active" url="/plan/pages/courses/courses" open-type="redirect">课程</navigator><navigator class="module-tab" url="/plan/pages/source/source" open-type="redirect">数据源</navigator><navigator class="module-tab module-home" url="/pages/portal/portal" open-type="reLaunch">NaviStudy</navigator></view>
