@import "../../module.wxss";

.source-heading { flex: 1; min-width: 0; }
.appbar .top-button { flex: 0 0 auto; width: auto; max-width: 230rpx; margin: 0; line-height: 1.3; }
.top-button text { overflow-wrap: anywhere; }
.snapshot-meta { margin: 10rpx 0 24rpx; font-size: 25rpx; line-height: 1.6; color: #46554d; }
.snapshot-time { margin-top: 4rpx; font-size: 22rpx; color: #65736c; font-variant-numeric: tabular-nums; }
.import-button { width: 100%; margin: 24rpx 0 0; line-height: 1.3; }
.actions .secondary-btn { width: 100%; min-width: 0; margin: 0; padding: 12rpx; line-height: 1.3; }
.import-error { margin-top: 20rpx; padding: 20rpx; border-radius: 10rpx; background: #fff2e4; color: #744118; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.error-title { margin-bottom: 8rpx; font-weight: 800; }
.domain-button { margin: 18rpx 0 0; width: 100%; line-height: 1.3; }
