<view class="passport-page theme-{{naviTheme}}">
  <view class="passport-brand">
    <view class="key-mark"><view></view></view>
    <view class="brand-copy"><text class="title">NaviPassport</text><text class="subtitle">一份身份，五项服务各自管理</text></view>
  </view>

  <view wx:if="{{newRecoveryCode}}" class="recovery-stage">
    <view class="stage-kicker">重要凭据</view>
    <text class="stage-title">请保存恢复码</text>
    <text class="stage-help">忘记密码时，它是唯一的找回方式。恢复码只显示这一次。</text>
    <view wx:if="{{inheritanceMessage}}" class="inheritance-message">{{inheritanceMessage}}</view>
    <text class="recovery-code" selectable>{{newRecoveryCode}}</text>
    <button class="primary" bindtap="copyRecovery"><text>{{recoveryCopied ? '已复制恢复码' : '复制恢复码'}}</text></button>
    <button class="text-button" disabled="{{!recoveryCopied}}" bindtap="finishRecovery"><text>我已妥善保存，继续</text></button>
  </view>

  <block wx:else>
    <view wx:if="{{account}}" class="account-surface">
      <view class="account-head">
        <view class="avatar">{{accountInitial}}</view>
        <view class="account-copy"><text>{{account.username}}</text><text>NaviPassport 已连接</text></view>
        <view class="connected-dot"></view>
      </view>

      <view class="sync-list">
        <view wx:for="{{services}}" wx:key="id" class="sync-row">
          <view class="sync-copy"><text>{{item.name}}</text><text>{{item.detail}}</text></view>
          <view class="sync-state state-{{item.state}}">
            <text class="sync-value">{{item.status}}</text>
            <text wx:if="{{item.syncTime}}" class="sync-time">{{item.syncTime}}</text>
            <button wx:if="{{item.state==='attention' || item.state==='offline'}}" disabled="{{busy}}" data-product="{{item.id}}" bindtap="retryService">重试</button>
          </view>
        </view>
      </view>

      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <view class="account-actions">
        <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="syncNow"><text>同步学习数据</text></button>
        <button class="logout-button" disabled="{{busy}}" bindtap="logout"><text>退出当前账号</text></button>
      </view>
    </view>

    <view wx:else class="auth-surface">
      <view class="tabs" role="tablist">
        <button class="{{mode === 'login' ? 'active' : ''}}" disabled="{{busy}}" data-mode="login" bindtap="setMode"><text>登录</text></button>
        <button class="{{mode === 'register' ? 'active' : ''}}" disabled="{{busy}}" data-mode="register" bindtap="setMode"><text>注册</text></button>
        <button class="{{mode === 'recover' ? 'active' : ''}}" disabled="{{busy}}" data-mode="recover" bindtap="setMode"><text>恢复</text></button>
      </view>
      <view class="auth-heading"><text>{{modeTitle}}</text><text>{{modeNote}}</text></view>
      <view wx:if="{{legacyHint && !legacyRegistration}}" class="legacy-notice">
        <text>{{legacyHint}}</text>
        <button disabled="{{busy}}" bindtap="chooseLegacyRegistration"><text>使用原用户名注册</text></button>
      </view>
      <label><text>用户名</text><input disabled="{{busy || legacyRegistration}}" maxlength="40" placeholder="输入 NaviPassport 用户名" value="{{username}}" bindinput="onUsername" /></label>
      <label wx:if="{{mode === 'recover'}}"><text>恢复码</text><input disabled="{{busy}}" placeholder="输入完整恢复码" value="{{recoveryCode}}" bindinput="onRecovery" /></label>
      <label>
        <view class="field-label"><text>{{mode === 'recover' ? '新密码' : '密码'}}</text><button disabled="{{busy}}" bindtap="togglePassword"><text>{{passwordVisible ? '隐藏' : '显示'}}</text></button></view>
        <input disabled="{{busy}}" password="{{!passwordVisible}}" maxlength="128" placeholder="{{mode === 'login' ? '输入密码' : '至少 6 个字符'}}" value="{{password}}" bindinput="onPassword" />
      </label>
      <label wx:if="{{mode !== 'login'}}"><text>确认密码</text><input disabled="{{busy}}" password="{{!passwordVisible}}" maxlength="128" placeholder="再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPassword" /></label>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit"><text>{{submitLabel}}</text></button>
    </view>
  </block>

  <view class="boundary"><text>NaviOJ 使用独立账号</text><text>NaviPassport 不会读取或修改 OJ 数据</text></view>
</view>
