.portal { width: 100%; min-width: 0; min-height: 100vh; padding: 56rpx 0 calc(42rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; overflow-x: hidden; background: #050608; color: #f6f7fb; transition: background-color 160ms ease-out, color 160ms ease-out; }
.portal-head { padding: 22rpx 34rpx 34rpx; }
.brand-lockup { display: flex; align-items: center; gap: 24rpx; }
.brand-lockup > view:last-child { flex: 1; min-width: 0; }
.brand-mark { width: 92rpx; height: 92rpx; flex: none; display: block; }
.brand-name { display: flex; align-items: baseline; color: #ffffff; font-size: 52rpx; line-height: 1.12; font-weight: 900; }
.brand-name-accent { color: #79e2bc; }
.brand-sub { margin-top: 10rpx; color: #969da9; font-size: 25rpx; }
.portal-actions { margin-top: 30rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14rpx; align-items: stretch; }
.passport-chip { width: 100%; min-height: 78rpx; padding: 10rpx 16rpx; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12rpx; border: 1rpx solid #2a2f38; border-radius: 12rpx; color: #e8ebf0; background: #111318; text-align: left; font-size: 23rpx; }
.passport-chip::after { border: 0; }
.passport-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #2c7be5; }
.passport-sync { color: #7f8792; font-size: 20rpx; }
.theme-toggle { min-width: 256rpx; min-height: 78rpx; padding: 10rpx 14rpx 10rpx 18rpx; border: 1rpx solid #2a2f38; border-radius: 12rpx; background: #111318; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.theme-copy { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.theme-label { color: #e8ebf0; font-size: 23rpx; line-height: 1.1; font-weight: 900; }
.theme-hint { max-width: 156rpx; color: #7f8792; font-size: 18rpx; line-height: 1.25; }
.theme-switch { transform: scale(0.82); transform-origin: right center; flex: none; }
.study-stack { width: 100%; min-width: 0; max-width: 100%; margin: 0; align-self: stretch; display: flex; flex-direction: column; }
.study-row { width: 100% !important; min-width: 0; max-width: 100%; margin: 0 !important; border-bottom: 1rpx solid rgba(255,255,255,0.09); border-radius: 0; display: flex; align-items: center; justify-content: flex-start; text-align: left; overflow: hidden; box-shadow: none; transition: background-color 120ms ease-out; }
.study-row:last-child { border-bottom: 0; }
.continue-row.study-row-pressed { background: #19385e; }
.module-words.study-row-pressed { background: #173129; }
.module-mt.study-row-pressed { background: #352b17; }
.module-plan.study-row-pressed { background: #241f47; }
.continue-row { min-height: 164rpx; padding: 26rpx 34rpx; gap: 24rpx; background: #142a46; color: #ffffff; }
.continue-row { border-top: 1rpx solid #293b53; border-bottom: 1rpx solid #293b53; }
.continue-empty { background: #15171b; color: #7f8692; opacity: 1; }
.continue-symbol { width: 72rpx; height: 72rpx; flex: none; border-radius: 16rpx; background: #2468b8; position: relative; }
.continue-empty .continue-symbol { background: #24272d; }
.continue-symbol::before { content: ""; position: absolute; left: 19rpx; top: 18rpx; width: 28rpx; height: 28rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.continue-hand { position: absolute; left: 35rpx; top: 27rpx; width: 4rpx; height: 18rpx; border-radius: 4rpx; background: currentColor; transform-origin: 50% 80%; transform: rotate(-38deg); }
.continue-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.continue-label { color: #8ebcf2; font-size: 20rpx; line-height: 1.2; font-weight: 800; }
.continue-empty .continue-label { color: #737a86; }
.continue-title { max-width: 100%; margin-top: 7rpx; color: currentColor; font-size: 31rpx; line-height: 1.2; font-weight: 900; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.continue-meta { max-width: 100%; margin-top: 8rpx; color: #aebfd3; font-size: 20rpx; line-height: 1.25; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.continue-empty .continue-meta { color: #686f7b; }
.module-group { width: 100%; min-width: 0; margin-top: 30rpx; border-top: 1rpx solid #272a30; border-bottom: 1rpx solid #272a30; display: flex; flex-direction: column; }
.module-row { min-height: 148rpx; padding: 24rpx 34rpx; gap: 24rpx; color: #ffffff; }
.module-words { background: #10251f; color: #f0fff9; }
.module-mt { background: #282113; color: #fff9eb; }
.module-plan { background: #1c1938; color: #f5f2ff; }
.module-oj { background: #1d2026; color: #eef1f5; }
.tools-group { margin-top: 30rpx; }
.group-label { padding: 0 34rpx 14rpx; color: #7f8792; font-size: 21rpx; font-weight: 800; }
.module-tools { background: #172528; color: #effcfa; border-top: 1rpx solid #2a3b3e; border-bottom: 1rpx solid #2a3b3e; }
.module-tools.study-row-pressed { background: #20363a; }
.module-symbol { width: 78rpx; height: 78rpx; flex: none; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.module-words .module-symbol { background: #176f5a; color: #ffffff; }
.module-mt .module-symbol { background: #8b671f; color: #ffffff; }
.module-plan .module-symbol { background: #6557da; color: #ffffff; }
.module-oj .module-symbol { background: #515b69; color: #ffffff; }
.module-tools .module-symbol { background: #247b78; color: #ffffff; }
.word-symbol { font-size: 30rpx; line-height: 1; font-weight: 900; }
.mt-symbol { width: 38rpx; display: flex; flex-direction: column; gap: 7rpx; }
.mt-bar { width: 38rpx; height: 5rpx; border-radius: 5rpx; background: currentColor; }
.mt-bar.short { width: 27rpx; }
.plan-symbol { width: 38rpx; height: 42rpx; display: flex; flex-direction: column; justify-content: space-between; }
.plan-symbol view { width: 38rpx; height: 8rpx; border-radius: 8rpx; background: currentColor; }
.plan-symbol view:nth-child(2) { width: 28rpx; }
.module-copy { flex: 1; min-width: 0; }
.module-topline { display: flex; align-items: baseline; justify-content: space-between; gap: 14rpx; }
.module-name { min-width: 0; color: currentColor; font-size: 29rpx; line-height: 1.2; font-weight: 900; word-break: break-word; }
.module-metric { flex: none; color: currentColor; font-size: 19rpx; line-height: 1; font-weight: 900; opacity: 0.7; }
.module-subject { max-width: 100%; margin-top: 10rpx; color: currentColor; font-size: 22rpx; line-height: 1.35; font-weight: 900; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.module-separator, .module-summary { font-weight: 700; opacity: 0.68; }
.row-action { width: 54rpx; height: 54rpx; flex: none; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
.continue-action { background: rgba(255,255,255,0.1); }
.continue-empty .continue-action { display: none; }
.row-arrow { width: 14rpx; height: 14rpx; margin-left: -5rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.web-entry { width: 100%; min-width: 0; margin-top: 30rpx; padding: 28rpx 34rpx; box-sizing: border-box; border-top: 1rpx solid #24364d; border-bottom: 1rpx solid #24364d; background: #0d1b2d; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24rpx; }
.web-entry-copy { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.web-entry-title { color: #f5f8fc; font-size: 25rpx; line-height: 1.35; font-weight: 900; }
.web-entry-url { color: #8294aa; font-size: 19rpx; line-height: 1.2; }
.web-entry-button { min-width: 216rpx; min-height: 74rpx; margin: 0; padding: 0 22rpx; border: 0; border-radius: 8rpx; background: #2463eb; color: #ffffff; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 23rpx; line-height: 1.2; font-weight: 900; }
.web-entry-button::after { border: 0; }
.web-entry-button-pressed { background: #1d4fc0; }
.web-entry-icon { width: 18rpx; height: 18rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; position: relative; box-sizing: border-box; }
.web-entry-icon::after { content: ""; width: 22rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; position: absolute; right: -3rpx; top: 7rpx; transform: rotate(-45deg); transform-origin: right center; }
.portal-foot { margin-top: auto; padding: 44rpx 34rpx 4rpx; color: #747b87; font-size: 21rpx; display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #22b789; }
.version { min-width: 96rpx; min-height: 88rpx; margin: -24rpx -12rpx -24rpx auto; display: flex; align-items: center; justify-content: flex-end; padding: 0 12rpx; box-sizing: border-box; font-variant-numeric: tabular-nums; user-select: none; }

.theme-light.portal { background: #eef4fb; color: #16202a; }
.theme-light .brand-name { color: #102033; }
.theme-light .brand-name-accent { color: #2463eb; }
.theme-light .brand-sub { color: #5d6b7b; }
.theme-light .brand-mark { filter: drop-shadow(0 12rpx 14rpx rgba(37, 99, 235, 0.18)); }
.theme-light .passport-chip,
.theme-light .theme-toggle { border-color: #cfdae8; background: #ffffff; color: #16202a; box-shadow: 0 12rpx 28rpx rgba(31, 48, 72, 0.08); }
.theme-light .passport-sync,
.theme-light .theme-hint { color: #647487; }
.theme-light .passport-dot { background: #256fcf; }
.theme-light .theme-label { color: #16202a; }
.theme-light .continue-row { background: #dcecff; color: #102033; border-top-color: #bdd4f2; border-bottom-color: #bdd4f2; }
.theme-light .continue-row.study-row-pressed { background: #c8e0ff; }
.theme-light .continue-label { color: #256fcf; }
.theme-light .continue-meta { color: #53697f; }
.theme-light .continue-empty { background: #ffffff; color: #647487; }
.theme-light .continue-empty .continue-symbol { background: #e8eef6; }
.theme-light .continue-empty .continue-label { color: #647487; }
.theme-light .continue-empty .continue-meta { color: #788697; }
.theme-light .module-group { border-top-color: #d2dce8; border-bottom-color: #d2dce8; }
.theme-light .tools-group .module-row { border-top-color: #c8dbe0; border-bottom-color: #c8dbe0; }
.theme-light .study-row { border-bottom-color: rgba(35, 53, 78, 0.12); }
.theme-light .module-words { background: #dff5ed; color: #123a30; }
.theme-light .module-mt { background: #fff2d8; color: #44320d; }
.theme-light .module-plan { background: #ebe8ff; color: #28215f; }
.theme-light .module-oj { background: #eef2f7; color: #27313e; }
.theme-light .module-tools { background: #dff3f3; color: #133c3d; }
.theme-light .module-words.study-row-pressed { background: #cbeadd; }
.theme-light .module-mt.study-row-pressed { background: #f5dfaf; }
.theme-light .module-plan.study-row-pressed { background: #dbd6ff; }
.theme-light .module-oj.study-row-pressed { background: #dde5ef; }
.theme-light .module-tools.study-row-pressed { background: #c8e6e6; }
.theme-light .module-words .module-symbol { background: #1a8168; }
.theme-light .module-mt .module-symbol { background: #a8791d; }
.theme-light .module-plan .module-symbol { background: #5e52d6; }
.theme-light .module-oj .module-symbol { background: #667386; }
.theme-light .module-tools .module-symbol { background: #247b78; }
.theme-light .web-entry { border-color: #c8d7ea; background: #e5eefb; }
.theme-light .web-entry-title { color: #15263c; }
.theme-light .web-entry-url { color: #62758d; }
.theme-light .group-label,
.theme-light .portal-foot { color: #687789; }
.theme-light .row-action { background: rgba(20, 34, 54, 0.1); }

@media (max-width: 380px) {
  .portal-actions { grid-template-columns: 1fr; }
  .theme-toggle { min-width: 0; }
  .theme-hint { max-width: 100%; }
  .web-entry { grid-template-columns: 1fr; }
  .web-entry-button { width: 100%; }
}
