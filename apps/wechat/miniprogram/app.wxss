page {
  min-height: 100%;
  background: #050608;
  color: #f6f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: none;
}

