@import "../../module.wxss";
.home {
  --bg: #0b0e12;
  --panel: #15191f;
  --panel-2: #1b2027;
  --line: #2a313b;
  --text: #f4f7fb;
  --muted: #8f9aa8;
  --accent: #4d8dff;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: var(--bg);
}
.words-header {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.brand-mark {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  border-radius: 10rpx;
  background: var(--accent);
  color: #fff;
  font-size: 21rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.words-brand {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.words-title {
  color: var(--text);
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 900;
}
.words-subtitle {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}
.switch-module {
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--panel);
  display: flex;
  align-items: center;
  justify-content: center;
}
.switch-grid {
  width: 28rpx;
  height: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5rpx;
}
.switch-grid view {
  border-radius: 2rpx;
  background: #aab4c2;
}
.launch-panel {
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--panel);
}
.launch-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.launch-head > view {
  flex: 1;
  min-width: 0;
}
.launch-head text {
  display: block;
}
.launch-kicker {
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 700;
}
.launch-title {
  margin-top: 8rpx;
  color: var(--text);
  font-size: 34rpx;
  line-height: 1.24;
  font-weight: 900;
  word-break: break-word;
}
.launch-progress {
  flex: none;
  color: #b7c1ce;
  font-size: 23rpx;
  font-weight: 800;
}
.book-strip {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}
.unit-strip {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}
.chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 4rpx;
}
.scope-chip,
.unit-chip {
  width: auto;
  flex: none;
  margin: 0;
  border: 1rpx solid var(--line);
  background: transparent;
  color: #a6b0bd;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scope-chip {
  min-width: 120rpx;
  height: 66rpx;
  padding: 0 22rpx;
  border-radius: 9rpx;
  font-size: 23rpx;
}
.unit-chip {
  min-width: 100rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.scope-chip.active,
.unit-chip.active {
  border-color: var(--accent);
  background: #1b3154;
  color: #82afff;
}
.content-kind-switch {
  margin-top: 20rpx;
  padding: 5rpx;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: #101419;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5rpx;
}
.content-kind-option {
  min-width: 0;
  height: 60rpx;
  border-radius: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 800;
}
.content-kind-option.active {
  background: var(--panel-2);
  color: var(--text);
}
.scope-summary {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--muted);
  font-size: 21rpx;
}
.progress-track {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 4rpx;
  background: #252b33;
  overflow: hidden;
}
.progress-value {
  height: 100%;
  background: var(--accent);
}
.launch-primary {
  min-height: 96rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: 9rpx;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.launch-primary.disabled {
  opacity: 0.4;
}
.launch-primary text {
  display: block;
}
.launch-primary-title {
  font-size: 28rpx;
  font-weight: 900;
}
.launch-primary-meta {
  max-width: 500rpx;
  margin-top: 6rpx;
  color: #e9f1ff;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.forward-arrow,
.row-arrow {
  width: 15rpx;
  height: 15rpx;
  flex: none;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}
.forward-arrow {
  margin-right: 7rpx;
}
.action-pressed,
.row-pressed {
  opacity: 0.75;
}
.mode-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.mode-button {
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
}
.mode-button text {
  display: block;
}
.mode-name {
  font-size: 24rpx;
  font-weight: 900;
}
.mode-note {
  color: var(--muted);
  font-size: 19rpx;
}
.progress-summary {
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.summary-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.summary-item + .summary-item {
  border-left: 1rpx solid var(--line);
}
.summary-value {
  color: var(--text);
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}
.summary-value.risk {
  color: #ff788d;
}
.summary-value.saved {
  color: #eab84b;
}
.summary-label {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 19rpx;
}
.section-head {
  margin-top: 32rpx;
  padding: 0 2rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text);
  font-size: 27rpx;
  font-weight: 900;
}
.section-link {
  color: #77a8ff;
  font-size: 21rpx;
  font-weight: 800;
}
.review-list {
  border-top: 1rpx solid var(--line);
}
.review-row {
  min-height: 106rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.review-mark {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 9rpx;
  font-size: 19rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wrong-mark {
  background: #3b2229;
  color: #ff8497;
}
.fav-mark {
  background: #392f1c;
  color: #efbf55;
}
.review-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.review-copy text:first-child {
  color: var(--text);
  font-size: 24rpx;
  font-weight: 900;
}
.review-copy text:last-child {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.35;
}
.review-count {
  min-width: 44rpx;
  color: #c5ccd6;
  font-size: 23rpx;
  font-weight: 800;
  text-align: right;
}
.row-arrow {
  margin-right: 8rpx;
  color: #677382;
}
.theme-light.home {
  --bg: #f5f7fa;
  --panel: #fff;
  --panel-2: #e9eef5;
  --line: #d8e0e9;
  --text: #172231;
  --muted: #687789;
  --accent: #3278e6;
}
.theme-light .content-kind-switch {
  background: #eef2f7;
}
.theme-light .scope-chip.active,
.theme-light .unit-chip.active {
  background: #e5efff;
  color: #215fae;
}
.theme-light .progress-track {
  background: #e1e7ef;
}
@media (max-width: 340px) {
  .home {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
  .words-subtitle {
    display: none;
  }
  .launch-panel {
    padding: 22rpx;
  }
  .launch-title {
    font-size: 30rpx;
  }
  .mode-note {
    display: none;
  }
}
