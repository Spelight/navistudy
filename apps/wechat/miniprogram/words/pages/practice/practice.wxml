<view class="page theme-{{naviTheme}} practice">
  <view class="practice-head">
    <view class="head-copy"><text class="scope">{{scopeLabel}}</text><text class="practice-title">{{displayTitle}}</text></view>
    <text class="progress">{{index + 1}} / {{words.length}}</text>
  </view>
  <view class="session-track"><view class="session-value" style="width: {{progressPercent}}%;"></view></view>
  <view class="mode-tabs">
    <view class="mode-tab {{mode==='card'?'active':''}}" data-mode="card" bindtap="switchMode">背诵</view>
    <view class="mode-tab {{mode==='choice'?'active':''}}" data-mode="choice" bindtap="switchMode">选择</view>
    <view class="mode-tab {{mode==='spell'?'active':''}}" data-mode="spell" bindtap="switchMode">拼写</view>
  </view>
  <view wx:if="{{!words.length}}" class="empty-state">当前范围没有词汇</view>
  <view wx:if="{{words.length}}" class="utility-row">
    <view class="tool-btn {{isFirst?'disabled':''}}" bindtap="prevWord" hover-class="control-pressed" aria-role="button"><view class="back-icon"></view><text>上一个</text></view>
    <view class="tool-btn {{favorite?'active':''}}" bindtap="toggleFav" hover-class="control-pressed" aria-role="button"><view class="favorite-icon"></view><text>{{favorite ? '已收藏' : '收藏'}}</text></view>
  </view>
  <view wx:if="{{words.length && mode==='card'}}" class="study-stage">
    <view class="term-block"><view class="word {{wordSizeClass}}">{{currentView.term}}</view><view wx:if="{{currentView.p}}" class="phonetic">{{currentView.p}}</view></view>
    <view wx:if="{{!flipped}}" class="primary-action reveal-btn" bindtap="flipCard" hover-class="control-pressed" aria-role="button"><text>查看答案</text><view class="action-arrow"></view></view>
    <view wx:if="{{flipped}}" class="defs definition-panel">
      <view class="content-toolbar">
        <text>{{kind==='word' ? '释义' : '中文释义'}}</text>
        <view wx:if="{{kind==='word'}}" class="language-options" aria-label="选择释义语言">
          <view wx:for="{{definitionModes}}" wx:key="id" class="language-option {{definitionMode===item.id?'active':''}}" data-mode="{{item.id}}" bindtap="selectDefinitionMode" hover-class="control-pressed" aria-role="button">{{item.label}}</view>
        </view>
      </view>
      <view class="definition-body">
        <view wx:if="{{currentView.showChinese}}" class="cn">{{currentView.definitionZh}}</view>
        <view wx:if="{{currentView.showEnglish}}" class="en">{{currentView.definitionEn}}</view>
        <view wx:if="{{currentView.fallbackLabel}}" class="definition-fallback-label">{{currentView.fallbackLabel}}</view>
        <view wx:if="{{currentView.fallbackText}}" class="definition-fallback">{{currentView.fallbackText}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{words.length && mode==='card' && flipped}}" class="assessment-actions">
    <view class="assessment-btn retry" bindtap="forgetWord" hover-class="control-pressed" aria-role="button">不认识</view>
    <view class="assessment-btn known" bindtap="knowWord" hover-class="control-pressed" aria-role="button">认识</view>
  </view>
  <view wx:if="{{words.length && mode==='choice'}}" class="quiz-stage">
    <view class="quiz-q">{{currentView.term}}</view><view class="quiz-sub">选择正确释义</view>
    <view wx:if="{{kind==='word'}}" class="content-toolbar choice-toolbar">
      <text>选项语言</text>
      <view class="language-options" aria-label="选择选项语言">
        <view wx:for="{{definitionModes}}" wx:key="id" class="language-option {{definitionMode===item.id?'active':''}}" data-mode="{{item.id}}" bindtap="selectDefinitionMode" hover-class="control-pressed" aria-role="button">{{item.label}}</view>
      </view>
    </view>
    <view wx:for="{{options}}" wx:key="key" class="option {{answered && item.key===current.key ? 'correct' : ''}} {{answered && selectedKey===item.key && item.key!==current.key ? 'wrong' : ''}}" data-key="{{item.key}}" bindtap="chooseOption" hover-class="control-pressed" aria-role="button"><text class="option-label">{{item.optionLabel}}</text><text class="option-text">{{item.optionText}}</text><text wx:if="{{answered && item.key===current.key}}" class="option-result">正确</text><text wx:if="{{answered && selectedKey===item.key && item.key!==current.key}}" class="option-result">错误</text></view>
    <view wx:if="{{answered}}" class="answer">{{answerText}}</view>
    <view wx:if="{{answered}}" class="primary-action next-question" bindtap="nextQuestion" hover-class="control-pressed" aria-role="button"><text>{{isLast ? '完成' : '下一题'}}</text><view class="action-arrow"></view></view>
  </view>
  <view wx:if="{{words.length && mode==='spell'}}" class="quiz-stage">
    <view class="spell-prompt">
      <view class="content-toolbar">
        <text>{{kind==='word' ? '释义提示' : '中文提示'}}</text>
        <view wx:if="{{kind==='word'}}" class="language-options" aria-label="选择提示语言">
          <view wx:for="{{definitionModes}}" wx:key="id" class="language-option {{definitionMode===item.id?'active':''}}" data-mode="{{item.id}}" bindtap="selectDefinitionMode" hover-class="control-pressed" aria-role="button">{{item.label}}</view>
        </view>
      </view>
      <view class="spell-def">{{currentView.spellPrompt}}</view>
    </view>
    <input class="spell-input" placeholder="输入英文{{kindLabel}}" value="{{spellInput}}" bindinput="onSpellInput" confirm-type="done" bindconfirm="checkSpell" />
    <view wx:if="{{!answered}}" class="primary-action next-question" bindtap="checkSpell" hover-class="control-pressed" aria-role="button"><text>确认</text><view class="action-arrow"></view></view>
    <view wx:if="{{answered}}" class="answer {{spellCorrect?'ok':'bad'}}">{{answerText}}</view>
    <view wx:if="{{answered}}" class="primary-action next-question" bindtap="nextQuestion" hover-class="control-pressed" aria-role="button"><text>{{isLast ? '完成' : '下一题'}}</text><view class="action-arrow"></view></view>
  </view>
</view>
