@import "../../module.wxss";
.me-page {
  --bg: #0b0e12;
  --panel: #15191f;
  --line: #2a313b;
  --text: #f4f7fb;
  --muted: #8f9aa8;
  --accent: #4d8dff;
  min-height: 100vh;
  padding: 28rpx;
  background: var(--bg);
}
.appbar {
  min-height: 58rpx;
  display: flex;
  align-items: center;
}
.nav-title {
  color: var(--text);
  font-size: 40rpx;
  font-weight: 900;
}
.panel {
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: var(--panel);
  box-shadow: none;
}
.account {
  margin-top: 22rpx;
  padding: 24rpx;
}
.profile-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.avatar {
  width: 82rpx;
  height: 82rpx;
  flex: none;
  border-radius: 9rpx;
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-main {
  flex: 1;
  min-width: 0;
}
.name {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 900;
  word-break: break-word;
}
.sync {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-word;
}
.passport-entry {
  width: 100%;
  min-height: 70rpx;
  margin-top: 20rpx;
  padding: 0 16rpx;
  border: 1rpx solid #3567ad;
  border-radius: 7rpx;
  background: #172a47;
  color: #dbe9ff;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 16rpx;
  align-items: center;
  gap: 10rpx;
  text-align: left;
  font-size: 21rpx;
  font-weight: 800;
}
.passport-entry text:nth-child(2) {
  color: #82afff;
  font-size: 19rpx;
}
.shortcut-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--line);
}
.shortcut {
  min-height: 88rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.shortcut-icon,
.tool-icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
  border-radius: 7rpx;
  background: #1b3154;
  position: relative;
}
.shortcut-copy,
.tool-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.shortcut-label,
.tool-title {
  color: var(--text);
  font-size: 23rpx;
  font-weight: 900;
}
.shortcut-desc,
.tool-desc {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.35;
  word-break: break-word;
}
.shortcut-num {
  color: var(--text);
  font-size: 29rpx;
  font-weight: 900;
}
.tool-list {
  margin-top: 18rpx;
  padding: 4rpx 22rpx;
}
.tool-row {
  min-height: 98rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tool-row:last-child {
  border-bottom: 0;
}
.tool-arrow {
  margin-left: auto;
  color: #687484;
  font-size: 27rpx;
}
.tool-row.danger .tool-title {
  color: #ff8296;
}
.tool-row.danger .tool-icon {
  background: #3a2027;
}
.about {
  margin-top: 18rpx;
  padding: 10rpx 22rpx;
  color: var(--text);
  font-size: 22rpx;
}
.about-row {
  min-height: 58rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.about-row:last-child {
  border-bottom: 0;
}
.about-row .muted {
  max-width: 70%;
  color: var(--muted);
  text-align: right;
  word-break: break-word;
}
.book-icon::before,
.web-icon::before,
.notice-icon::before,
.wrong-icon::before,
.star-icon::before,
.export-icon::before,
.import-icon::before,
.share-icon::before,
.clear-icon::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 11rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #82afff;
  border-radius: 4rpx;
}
.wrong-icon,
.clear-icon {
  background: #3a2027;
}
.wrong-icon::before,
.clear-icon::before {
  border-color: #ff8296;
  border-radius: 50%;
}
.star-icon {
  background: #392f1c;
}
.star-icon::before {
  border-color: #efbf55;
  transform: rotate(45deg);
}
.theme-light.me-page {
  --bg: #f5f7fa;
  --panel: #fff;
  --line: #d8e0e9;
  --text: #172231;
  --muted: #687789;
  --accent: #3278e6;
}
@media (max-width: 340px) {
  .me-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
  .passport-entry {
    grid-template-columns: minmax(0, 1fr) 16rpx;
  }
  .passport-entry text:nth-child(2) {
    display: none;
  }
}
