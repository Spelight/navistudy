@import "../../module.wxss";
.me-page {
  padding-bottom: 46rpx;
}

.appbar {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #f6f7fb;
  font-size: 36rpx;
  font-weight: 900;
}

.account,
.tool-list,
.about {
  margin-top: 26rpx;
  padding: 28rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #243754;
  color: #79b1ff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.name {
  color: #ffffff;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
  word-break: break-word;
}

.sync {
  margin-top: 10rpx;
  color: #9aa1ad;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-word;
}

.passport-entry {
  width: 100%;
  min-height: 76rpx;
  margin: 26rpx 0 0;
  padding: 0 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 18rpx;
  align-items: center;
  gap: 13rpx;
  border: 1rpx solid #285a50;
  border-radius: 10rpx;
  color: #dff8f0;
  background: #16302a;
  text-align: left;
  font-size: 23rpx;
  font-weight: 800;
}

.passport-entry::after { border: 0; }
.passport-entry text:nth-child(2) { color: #71c5ad; font-size: 21rpx; }
.passport-entry text:first-child,
.passport-entry text:nth-child(2) { min-width: 0; word-break: break-word; }

.shortcut-list {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #303238;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.shortcut {
  min-height: 92rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #17181c;
  color: #daddE6;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.shortcut-icon,
.tool-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #243754;
  position: relative;
  flex: none;
}

.shortcut-num {
  margin-left: auto;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

.shortcut-copy,
.tool-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.shortcut-label,
.tool-title {
  color: #f2f4f8;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 900;
}

.shortcut-desc,
.tool-desc {
  margin-top: 8rpx;
  color: #8f96a2;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
  word-break: break-word;
}

.tool-list {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.tool-row {
  width: 100%;
  min-height: 112rpx;
  padding: 0;
  border-bottom: 1rpx solid #303238;
  color: #f2f4f8;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
}

.tool-row:last-child {
  border-bottom: none;
}

.tool-row.danger {
  color: #ff8fa5;
}

.tool-row.danger .tool-title {
  color: #ff8fa5;
}

.tool-arrow {
  margin-left: auto;
  color: #747b86;
  font-size: 34rpx;
}

.wrong-icon,
.clear-icon {
  background: #45202a;
}

.star-icon {
  background: #403318;
}

.book-icon,
.export-icon,
.import-icon,
.web-icon,
.share-icon,
.notice-icon {
  background: #243754;
}

.book-icon::before,
.web-icon::before,
.notice-icon::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 7rpx;
  border: 4rpx solid #5aa0ff;
}

.book-icon::after {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 12rpx;
  width: 18rpx;
  height: 30rpx;
  border-left: 4rpx solid #5aa0ff;
  border-right: 4rpx solid #5aa0ff;
}

.web-icon::before {
  border-radius: 50%;
}

.web-icon::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 25rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #5aa0ff;
}

.wrong-icon::before,
.clear-icon::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #ff6b81;
  border-color: #ff6b81;
  border-radius: 50%;
}

.wrong-icon::after,
.clear-icon::after {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 27rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #ff6b81;
}

.star-icon::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 15rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #f0b544;
  border-radius: 7rpx;
  border-color: #f0b544;
  transform: rotate(45deg);
}

.star-icon::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 25rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f0b544;
}

.export-icon::before,
.import-icon::before,
.share-icon::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 13rpx;
  width: 18rpx;
  height: 24rpx;
  border-left: 4rpx solid #5aa0ff;
  border-bottom: 4rpx solid #5aa0ff;
}

.export-icon::after,
.import-icon::after {
  content: "";
  position: absolute;
  left: 23rpx;
  width: 8rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #5aa0ff;
}

.export-icon::after {
  top: 13rpx;
}

.import-icon::after {
  top: 21rpx;
}

.share-icon::before {
  width: 24rpx;
  height: 18rpx;
  border-left: 0;
  border-bottom-left-radius: 8rpx;
}

.share-icon::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid #5aa0ff;
  border-right: 4rpx solid #5aa0ff;
  transform: rotate(45deg);
}

.notice-icon::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 20rpx;
  width: 5rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: #5aa0ff;
}

.about {
  color: #f2f4f8;
  font-size: 27rpx;
}

.about-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #303238;
  align-items: flex-start;
  padding: 14rpx 0;
}

.about-row .muted {
  max-width: 72%;
  text-align: right;
  word-break: break-word;
}

.about-row:last-child {
  border-bottom: none;
}
