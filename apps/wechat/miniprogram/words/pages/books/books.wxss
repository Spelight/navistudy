@import "../../module.wxss";
.outline {
  --bg: #0b0e12;
  --panel: #15191f;
  --line: #2a313b;
  --text: #f4f7fb;
  --muted: #8f9aa8;
  --accent: #4d8dff;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: var(--bg);
}
.outline-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}
.outline-head > view {
  display: flex;
  flex-direction: column;
}
.outline-kicker {
  color: #77a8ff;
  font-size: 20rpx;
  font-weight: 800;
}
.outline-title {
  margin-top: 5rpx;
  color: var(--text);
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 900;
}
.start-current {
  width: auto;
  min-width: 154rpx;
  height: 66rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: var(--accent);
  color: #fff;
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.book-selector {
  min-height: 88rpx;
  margin-top: 28rpx;
  padding: 15rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: var(--panel);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.book-selector > view {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.selector-label {
  color: var(--muted);
  font-size: 19rpx;
}
.selector-value {
  margin-top: 4rpx;
  color: var(--text);
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.selector-arrow {
  color: #8e9aaa;
  font-size: 30rpx;
}
.content-kind-switch {
  margin-top: 12rpx;
  padding: 5rpx;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: #101419;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5rpx;
}
.content-kind-option {
  min-width: 0;
  height: 58rpx;
  border-radius: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 800;
}
.content-kind-option.active {
  background: #202630;
  color: var(--text);
}
.scope-overview {
  margin-top: 30rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}
.scope-overview > view {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.scope-title {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 900;
}
.scope-meta {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 21rpx;
}
.scope-percent {
  color: #82afff;
  font-size: 31rpx;
  font-weight: 900;
}
.progress-line {
  height: 8rpx;
  margin-top: 14rpx;
  background: #242a32;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--accent);
}
.unit-tabs {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}
.unit-tab-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
}
.unit-tab {
  height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: #a5afbc;
  font-size: 21rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.unit-tab.active {
  border-color: var(--accent);
  background: #1b3154;
  color: #82afff;
}
.search {
  width: 100%;
  height: 78rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--panel);
  color: var(--text);
  font-size: 24rpx;
}
.view-switch {
  width: 100%;
  margin-top: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}
.view-chip {
  height: 54rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 800;
}
.view-chip.active {
  color: #82afff;
  border-bottom: 4rpx solid var(--accent);
}
.unit-list {
  margin-top: 10rpx;
  border-top: 1rpx solid var(--line);
}
.unit-row {
  min-height: 118rpx;
  padding: 20rpx 2rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.unit-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.unit-row-name {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 900;
}
.unit-row.active .unit-row-name {
  color: #82afff;
}
.unit-row-meta {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 20rpx;
}
.unit-progress {
  height: 5rpx;
  margin-top: 13rpx;
  background: #242a32;
  overflow: hidden;
}
.unit-progress view {
  height: 100%;
  background: var(--accent);
}
.unit-start {
  width: 102rpx;
  height: 58rpx;
  flex: none;
  border: 1rpx solid #3a67a8;
  border-radius: 7rpx;
  color: #82afff;
  font-size: 21rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-head {
  margin: 22rpx 2rpx 10rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--muted);
  font-size: 19rpx;
}
.word-row {
  min-height: 126rpx;
  padding: 20rpx 2rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.word-index {
  width: 42rpx;
  flex: none;
  padding-top: 5rpx;
  color: #657181;
  font-size: 19rpx;
}
.word-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.word-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.word {
  color: var(--text);
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 900;
  word-break: break-word;
}
.state {
  flex: none;
  max-width: 150rpx;
  padding: 5rpx 9rpx;
  border-radius: 5rpx;
  background: #242a32;
  color: #9aa5b3;
  font-size: 18rpx;
}
.state.done {
  background: #12362c;
  color: #76dfbd;
}
.state.wrong {
  background: #3a2027;
  color: #ff91a4;
}
.state.fav {
  color: #efbf55;
}
.phonetic {
  margin-top: 5rpx;
  color: #758191;
  font-size: 19rpx;
}
.definition {
  margin-top: 8rpx;
  color: #aeb8c4;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-word;
}
.definition.secondary {
  margin-top: 4rpx;
  color: #e5e9ef;
}
.empty-state {
  margin-top: 22rpx;
  padding: 70rpx 20rpx;
  border: 1rpx dashed var(--line);
  color: var(--muted);
  text-align: center;
}
.theme-light.outline {
  --bg: #f5f7fa;
  --panel: #fff;
  --line: #d8e0e9;
  --text: #172231;
  --muted: #687789;
  --accent: #3278e6;
}
.theme-light .content-kind-switch {
  background: #eef2f7;
}
.theme-light .unit-tab.active {
  background: #e5efff;
  color: #215fae;
}
.theme-light .progress-line,
.theme-light .unit-progress {
  background: #e1e7ef;
}
@media (max-width: 340px) {
  .outline {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
  .outline-title {
    font-size: 36rpx;
  }
  .start-current {
    min-width: 138rpx;
  }
  .scope-title {
    font-size: 29rpx;
  }
}
