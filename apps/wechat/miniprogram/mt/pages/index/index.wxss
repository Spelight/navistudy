@import "../../module.wxss";
.home { padding-bottom: 44rpx; }
.brand-mark, .bank-link { width: 76rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 23rpx; font-weight: 900; }
.brand-mark { background: #243754; color: #73adff; }
.bank-link { background: #15161a; color: #70adff; }
.notice { margin-top: 24rpx; padding: 22rpx; display: flex; align-items: flex-start; gap: 18rpx; box-shadow: none; }
.notice-signal { width: 42rpx; height: 42rpx; flex: none; border-radius: 50%; background: #403318; color: #f0b544; display: flex; align-items: center; justify-content: center; font-weight: 900; }
.notice-text { flex: 1; color: #b8bdc7; font-size: 24rpx; line-height: 1.55; }
.notice-close { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.close-mark { width: 24rpx; height: 24rpx; position: relative; transform: rotate(45deg); }
.close-mark::before, .close-mark::after { content: ""; position: absolute; left: 10rpx; top: 0; width: 4rpx; height: 24rpx; border-radius: 4rpx; background: #8c929e; }
.close-mark::after { transform: rotate(90deg); }
.overview-head { margin-top: 42rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.chapter-name { color: #ffffff; font-size: 45rpx; line-height: 1.2; font-weight: 900; }
.chapter-progress { margin-top: 12rpx; color: #9ba1ac; font-size: 25rpx; }
.percent { color: #64a5ff; font-size: 38rpx; font-weight: 900; }
.progress-line { height: 14rpx; margin-top: 22rpx; border-radius: 999rpx; background: #27292e; overflow: hidden; }
.progress-fill { height: 100%; min-width: 8rpx; border-radius: inherit; background: #2c7be5; }
.metric-grid { margin-top: 26rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.metric { min-width: 0; min-height: 196rpx; padding: 20rpx 12rpx; box-shadow: none; display: flex; flex-direction: column; align-items: flex-start; }
.metric-mark { width: 30rpx; height: 30rpx; border-radius: 8rpx; background: #2c7be5; }
.metric-mark.remaining { background: #687080; }
.metric-mark.wrong { background: #e05670; }
.metric-mark.favorite { background: #d79a27; }
.metric-label { margin-top: 18rpx; color: #a6acb7; font-size: 21rpx; font-weight: 800; }
.metric-num { margin-top: 4rpx; color: #ffffff; font-size: 40rpx; line-height: 1.05; font-weight: 900; }
.metric-sub { margin-top: 8rpx; color: #858c98; font-size: 19rpx; }
.resume { margin-top: 22rpx; padding: 24rpx; display: flex; align-items: center; gap: 18rpx; box-shadow: none; }
.resume-copy { flex: 1; min-width: 0; }
.resume-title { color: #ffffff; font-size: 28rpx; font-weight: 900; }
.resume-meta { margin-top: 8rpx; color: #9299a5; font-size: 22rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.resume-btn { width: 104rpx; height: 58rpx; border-radius: 14rpx; background: #172f55; color: #6faaff; font-size: 24rpx; font-weight: 800; }
.scope-panel { margin-top: 22rpx; padding: 26rpx; box-shadow: none; }
.scope-meta { margin-top: 8rpx; color: #9097a3; font-size: 23rpx; }
.chapter-picker { margin-top: 22rpx; height: 78rpx; padding: 0 22rpx; border-radius: 14rpx; background: #121317; color: #ffffff; font-size: 27rpx; font-weight: 800; display: flex; align-items: center; justify-content: space-between; }
.chev { color: #8c929e; font-size: 21rpx; }
.section-row { margin: 34rpx 4rpx 16rpx; }
.mode-primary { padding: 28rpx 24rpx; display: flex; align-items: center; gap: 20rpx; box-shadow: none; }
.mode-copy { flex: 1; min-width: 0; }
.mode-title { color: #f7f8fc; font-size: 28rpx; line-height: 1.25; font-weight: 900; }
.mode-desc { margin-top: 8rpx; color: #939aa6; font-size: 22rpx; line-height: 1.45; }
.mode-action { color: #69a8ff; font-size: 25rpx; font-weight: 900; }
.mode-grid { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.mode-card { min-height: 218rpx; padding: 24rpx; box-shadow: none; }
.mode-card .mode-title { margin-top: 22rpx; }
.mode-mark { width: 52rpx; height: 52rpx; border-radius: 14rpx; background: #243754; position: relative; flex: none; }
.mode-mark::after { content: ""; position: absolute; left: 15rpx; top: 15rpx; width: 18rpx; height: 18rpx; border: 3rpx solid #68a6ff; border-radius: 4rpx; }
.mode-mark.random { background: #18382f; }
.mode-mark.random::after { border-color: #64d6b0; transform: rotate(45deg); }
.mode-mark.wrong { background: #45202a; }
.mode-mark.wrong::after { border-color: #ff8fa5; border-radius: 50%; }
.mode-mark.favorite { background: #403318; }
.mode-mark.favorite::after { border-color: #f0b544; transform: rotate(45deg); }
.mode-mark.short { background: #30254a; }
.mode-mark.short::after { border-color: #bca4ff; border-radius: 50%; }
