@import "../../module.wxss";
.bank-page { padding-bottom: 44rpx; }
.bank-sub { margin-top: 8rpx; color: #969ca8; font-size: 23rpx; }
.start-mini { width: 104rpx; height: 60rpx; flex: none; border-radius: 14rpx; background: #172f55; color: #6faaff; font-size: 24rpx; font-weight: 800; }
.summary-line { margin-top: 30rpx; display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.summary-num { color: #ffffff; font-size: 44rpx; font-weight: 900; }
.summary-label, .summary-progress { color: #9299a5; font-size: 23rpx; }
.filter-scroll, .type-scroll { margin-top: 24rpx; white-space: nowrap; }
.type-scroll { margin-top: 14rpx; }
.filter-row { display: inline-flex; padding-right: 30rpx; gap: 12rpx; }
.filter-chip, .type-chip { min-height: 62rpx; padding: 0 22rpx; border-radius: 14rpx; background: #1c1d20; color: #a0a6b1; font-size: 24rpx; font-weight: 800; }
.type-chip { min-height: 54rpx; background: #121317; font-size: 22rpx; }
.filter-chip.active, .type-chip.active { background: #2c7be5; color: #ffffff; }
.search { margin-top: 24rpx; }
.question-row { margin-top: 16rpx; padding: 24rpx; box-shadow: none; }
.row-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row-tags { display: flex; align-items: center; gap: 10rpx; }
.type-tag, .legacy-tag, .status { min-height: 40rpx; padding: 7rpx 12rpx; border-radius: 10rpx; font-size: 20rpx; font-weight: 800; }
.type-tag { background: #243754; color: #72adff; }
.legacy-tag { background: #3b301a; color: #dfae55; }
.status { background: #292b30; color: #969ca7; }
.status.done { background: #073d31; color: #72e0bb; }
.status.wrong { background: #4a1d29; color: #ff9caf; }
.row-stem { margin-top: 18rpx; color: #f5f6fa; font-size: 28rpx; line-height: 1.58; font-weight: 700; word-break: break-word; }
.row-foot { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #303238; display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.row-source { flex: 1; min-width: 0; color: #858c98; font-size: 21rpx; line-height: 1.4; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fav-state { flex: none; color: #e1ad4c; font-size: 21rpx; }
.load-more { width: 100%; height: 76rpx; margin-top: 22rpx; border-radius: 14rpx; background: #23252a; color: #72adff; font-size: 25rpx; font-weight: 800; }
.list-end { padding: 30rpx 0 6rpx; color: #747b87; font-size: 22rpx; text-align: center; }

