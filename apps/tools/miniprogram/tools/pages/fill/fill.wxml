<view class="page"><view wx:if="{{session}}"><view class="hero"><view class="hero-label">{{session.termLabel}} · {{session.weekLabel}}</view><view class="hero-title">{{session.title}}</view><view class="hero-copy">{{session.nameRequired ? '填写姓名后，拖动选择所有有空的时段。' : '姓名选填，拖动选择所有有空的时段。'}}</view></view><label class="field">姓名{{session.nameRequired ? '' : '（选填）'}}<input class="input" value="{{name}}" bindinput="inputName" maxlength="40"/></label><view class="selection-count">已选择 {{selected.length}} 个时段</view><scroll-view class="grid-scroll" scroll-x enhanced><view class="time-grid" style="{{gridStyle}}"><view class="grid-cell head">节次</view><view wx:for="{{session.days}}" wx:for-item="day" wx:key="id" class="grid-cell head">{{day.label}}</view><block wx:for="{{session.periods}}" wx:for-item="period" wx:key="id"><view class="grid-cell head"><text>{{period.label}}</text><text class="period-time">{{period.start}}</text></view><view wx:for="{{session.days}}" wx:for-item="day" wx:key="id" class="grid-cell {{selectedMap[day.id + '-' + period.id] ? 'selected' : ''}}" data-slot="{{day.id + '-' + period.id}}" bindtouchstart="beginSelect" catchtouchmove="moveSelect" bindtouchend="endSelect">{{selectedMap[day.id + '-' + period.id] ? '有空' : ''}}</view></block></view></scroll-view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary-btn" style="margin-top:24rpx" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">{{token ? '更新我的提交' : '提交空闲时间'}}</button></view><view wx:else class="panel empty">{{error || '正在读取问卷...'}}</view></view>
