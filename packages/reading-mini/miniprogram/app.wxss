page {
  min-height: 100%;
  color: #20302c;
  background: #f4f7f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 154rpx;
}

.eyebrow {
  color: #267362;
  font-size: 21rpx;
  font-weight: 800;
}

.page-title {
  margin-top: 10rpx;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 47rpx;
  line-height: 1.18;
  font-weight: 700;
}

.muted {
  color: #697672;
}

.primary,
.secondary {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.primary {
  color: #fff;
  background: #267362;
}

.secondary {
  color: #245e51;
  border: 1rpx solid #afc9c1;
  background: #fff;
}
