.saved-page { padding-top: 48rpx; }
.passport-row { width: 100%; min-height: 82rpx; margin: 30rpx 0 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 6rpx; color: #245e51; background: #e1ece8; font-size: 23rpx; font-weight: 800; }
.saved-list { margin-top: 28rpx; border-top: 1rpx solid #cfdbd7; }
.saved-row { width: 100%; margin: 0; padding: 24rpx 0; display: block; border-bottom: 1rpx solid #cfdbd7; border-radius: 0; background: transparent; text-align: left; }
.saved-row text { display: block; word-break: break-word; }
.saved-place { color: #267362; font-size: 20rpx; font-weight: 900; }
.saved-title { margin-top: 7rpx; font-family: Georgia, serif; font-size: 27rpx; line-height: 1.35; font-weight: 700; }
.saved-excerpt { margin-top: 9rpx; color: #697672; font-family: Georgia, serif; font-size: 22rpx; line-height: 1.6; }
.saved-note { margin-top: 13rpx; padding: 15rpx 17rpx; color: #385c53; border-radius: 5rpx; background: #e6efec; font-size: 22rpx; line-height: 1.55; }
.empty-state { margin-top: 32rpx; padding: 80rpx 24rpx; border-top: 1rpx solid #cfdbd7; border-bottom: 1rpx solid #cfdbd7; text-align: center; }
.empty-state text { display: block; color: #697672; font-size: 23rpx; }
.empty-state text:first-child { color: #2c3d38; font-size: 29rpx; font-weight: 900; }
.empty-state text + text { margin-top: 10rpx; }
