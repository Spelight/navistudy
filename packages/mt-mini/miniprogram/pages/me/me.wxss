.me-page { padding-bottom: 46rpx; }
.appbar { justify-content: center; }
.profile, .tool-list, .about { margin-top: 26rpx; padding: 28rpx; }
.profile-row { display: flex; align-items: center; gap: 22rpx; }
.avatar { width: 104rpx; height: 104rpx; flex: none; border-radius: 50%; background: #243754; color: #79b1ff; font-size: 31rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; }
.profile-copy { flex: 1; min-width: 0; }
.profile-title { color: #ffffff; font-size: 38rpx; line-height: 1.2; font-weight: 900; }
.profile-sub { margin-top: 9rpx; color: #969da8; font-size: 24rpx; }
.passport-entry { width: 100%; min-height: 76rpx; margin: 24rpx 0 0; padding: 0 18rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto 18rpx; align-items: center; gap: 13rpx; border: 1rpx solid #344968; border-radius: 10rpx; color: #dbe9fa; background: #18283e; text-align: left; font-size: 23rpx; font-weight: 800; }
.passport-entry::after { border: 0; }
.passport-entry text:nth-child(2) { color: #78a8e4; font-size: 21rpx; }
.accuracy-row { margin-top: 28rpx; padding: 24rpx 0; border-top: 1rpx solid #303238; border-bottom: 1rpx solid #303238; display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.accuracy-num { color: #6faaff; font-size: 44rpx; font-weight: 900; }
.accuracy-label { margin-left: 14rpx; color: #a0a6b1; font-size: 22rpx; }
.accuracy-meta { color: #9299a5; font-size: 22rpx; }
.shortcut-list { margin-top: 18rpx; display: flex; flex-direction: column; }
.shortcut { min-height: 100rpx; border-bottom: 1rpx solid #303238; display: flex; align-items: center; gap: 18rpx; }
.shortcut:last-child { border-bottom: 0; }
.shortcut-mark, .tool-mark { width: 48rpx; height: 48rpx; flex: none; border-radius: 12rpx; background: #243754; position: relative; }
.shortcut-mark.wrong, .tool-mark.clear { background: #45202a; }
.shortcut-mark.favorite { background: #403318; }
.shortcut-mark.mastered { background: #073d31; }
.shortcut-mark::after, .tool-mark::after { content: ""; position: absolute; left: 14rpx; top: 14rpx; width: 20rpx; height: 20rpx; border-radius: 6rpx; background: #6faaff; }
.shortcut-mark.wrong::after, .tool-mark.clear::after { background: #ff839b; }
.shortcut-mark.favorite::after { background: #e0aa42; transform: rotate(45deg); }
.shortcut-mark.mastered::after { background: #65d3ae; border-radius: 50%; }
.shortcut-copy, .tool-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.shortcut-title, .tool-title { color: #f2f4f8; font-size: 27rpx; line-height: 1.25; font-weight: 900; }
.shortcut-desc, .tool-desc { margin-top: 7rpx; color: #8f96a2; font-size: 21rpx; line-height: 1.4; }
.shortcut-num { margin-left: auto; color: #ffffff; font-size: 34rpx; font-weight: 900; }
.tool-list { padding-top: 8rpx; padding-bottom: 8rpx; }
.tool-row { min-height: 112rpx; border-bottom: 1rpx solid #303238; display: flex; align-items: center; gap: 20rpx; }
.tool-row:last-child { border-bottom: 0; }
.tool-arrow { width: 16rpx; height: 16rpx; margin-left: auto; border-top: 3rpx solid #747b86; border-right: 3rpx solid #747b86; transform: rotate(45deg); }
.tool-row.danger .tool-title { color: #ff91a5; }
.tool-mark.export::after { clip-path: polygon(40% 0,60% 0,60% 55%,85% 35%,100% 52%,50% 100%,0 52%,15% 35%,40% 55%); }
.tool-mark.import::after { clip-path: polygon(50% 0,100% 48%,85% 65%,60% 45%,60% 100%,40% 100%,40% 45%,15% 65%,0 48%); }
.tool-mark.share::after { border-radius: 50%; box-shadow: 15rpx -10rpx 0 #6faaff, 15rpx 10rpx 0 #6faaff; }
.tool-mark.notice::after { border-radius: 50%; }
.about { color: #f2f4f8; font-size: 25rpx; }
.about-row { min-height: 66rpx; border-bottom: 1rpx solid #303238; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.about-row:last-child { border-bottom: 0; }
.disclaimer { padding: 28rpx 12rpx 8rpx; color: #747b87; font-size: 21rpx; line-height: 1.58; text-align: center; }
