.book-page {
  padding-bottom: 190rpx;
}

.book-hero {
  min-height: 190rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #1c1d20;
}

.book-hero > view:first-child,
.resume > view:first-child,
.unit-card > view:first-child,
.start-bar > view:first-child {
  flex: 1;
  min-width: 0;
}

.book-name {
  max-width: 100%;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #f7f8fc;
  word-break: break-word;
}

.book-meta {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #969ca8;
}

.book-badge,
.unit-count,
.resume-action {
  flex: none;
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #243754;
  color: #5aa0ff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resume {
  margin-top: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.resume-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #f7f8fc;
}

.resume-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969ca8;
  line-height: 1.4;
  word-break: break-word;
}

.block-title {
  margin: 34rpx 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #f7f8fc;
}

.kind-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.kind-option {
  min-width: 0;
  min-height: 84rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #1c1d20;
  color: #a3a9b4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 800;
}

.kind-option::after, .definition-option::after { border: 0; }
.kind-option.active { background: #243754; color: #79b1ff; }
.kind-option text:last-child { font-variant-numeric: tabular-nums; }

.definition-row {
  min-height: 76rpx;
  margin-top: 14rpx;
  padding: 10rpx 12rpx 10rpx 20rpx;
  border-radius: 14rpx;
  background: #15161a;
  color: #a4aab5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.definition-options { display: flex; gap: 6rpx; }
.definition-option {
  min-width: 92rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 9rpx;
  background: transparent;
  color: #969ca8;
  font-size: 22rpx;
  font-weight: 800;
}
.definition-option.active { background: #243754; color: #79b1ff; }

.unit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.unit-card {
  min-height: 118rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.unit-card.active {
  background: #202736;
}

.unit-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #f7f8fc;
}

.unit-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969ca8;
  line-height: 1.4;
  word-break: break-word;
}

.mode-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.mode-card {
  min-width: 0;
  min-height: 126rpx;
  padding: 20rpx 12rpx;
  border-radius: 18rpx;
  background: #1c1d20;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.mode-card.active {
  background: #2c7be5;
}

.mode-label {
  font-size: 28rpx;
  font-weight: 900;
  color: #f7f8fc;
}

.mode-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #969ca8;
}

.mode-card.active .mode-label,
.mode-card.active .mode-desc {
  color: #ffffff;
}

.start-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 34rpx;
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  z-index: 90;
}

.start-count {
  font-size: 30rpx;
  font-weight: 900;
  color: #f7f8fc;
}

.start-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #969ca8;
  line-height: 1.35;
}

.start-btn {
  width: 230rpx;
  max-width: 42%;
  flex: none;
}
