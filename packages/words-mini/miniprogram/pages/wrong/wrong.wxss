.wrong-page {
  --bg: #0b0e12;
  --panel: #15191f;
  --line: #2a313b;
  --text: #f4f7fb;
  --muted: #8f9aa8;
  --accent: #4d8dff;
  min-height: 100vh;
  padding: 28rpx;
  background: var(--bg);
}
.page-kicker {
  color: #77a8ff;
  font-size: 20rpx;
  font-weight: 800;
}
.top-title {
  margin-top: 5rpx;
  color: var(--text);
  font-size: 40rpx;
  font-weight: 900;
}
.wrong-sub {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
}
.panel {
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: var(--panel);
  box-shadow: none;
}
.stats {
  margin-top: 22rpx;
  padding: 20rpx 8rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.stat-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-item + .stat-item {
  border-left: 1rpx solid var(--line);
}
.stat-num {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 900;
}
.stat-label {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}
.filter-tabs {
  margin-top: 20rpx;
  white-space: nowrap;
}
.filter-tab {
  display: inline-flex;
  height: 58rpx;
  padding: 0 20rpx;
  margin-right: 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  align-items: center;
  justify-content: center;
  color: #a5afbc;
  font-size: 21rpx;
  font-weight: 800;
}
.filter-tab.active {
  border-color: var(--accent);
  background: #1b3154;
  color: #82afff;
}
.type-tabs {
  margin-top: 12rpx;
  padding: 5rpx;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: #101419;
  display: flex;
}
.kind-tabs {
  margin-top: 22rpx;
}
.type-tab {
  flex: 1;
  height: 56rpx;
  border-radius: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.type-tab.active {
  background: #202630;
  color: var(--text);
}
.practice-actions {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}
.practice-actions button {
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  height: auto;
  padding: 12rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 7rpx;
  color: #b7c1cd;
  font-size: 21rpx;
  font-weight: 800;
}
.practice-actions .primary-btn {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}
.list-head {
  margin: 26rpx 2rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 20rpx;
}
.list-actions {
  margin-left: auto;
  display: flex;
  gap: 20rpx;
}
.manage-link {
  color: #77a8ff;
  font-weight: 800;
}
.clear-link {
  color: #ff8296;
  font-weight: 800;
}
.batch-bar {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.batch-select {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text);
  font-size: 21rpx;
  font-weight: 800;
}
.check-wrap {
  width: 44rpx;
  padding-top: 4rpx;
  flex: none;
}
.check {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #586473;
  border-radius: 5rpx;
}
.check.checked {
  border-color: var(--accent);
  background: var(--accent);
  position: relative;
}
.check.checked::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 8rpx;
  height: 15rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}
.delete-selected {
  width: auto;
  min-width: 166rpx;
  min-height: 56rpx;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: #3a2027;
  color: #ff91a4;
  font-size: 20rpx;
  font-weight: 800;
}
.delete-selected.disabled {
  background: #242a32;
  color: #6f7a88;
}
.empty {
  padding: 58rpx 26rpx;
  text-align: center;
}
.empty-title {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 900;
}
.empty-text {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}
.wrong-card {
  margin: 0;
  padding: 22rpx 2rpx;
  border: 0;
  border-top: 1rpx solid var(--line);
  border-radius: 0;
  background: transparent;
}
.wrong-body {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.wrong-main {
  flex: 1;
  min-width: 0;
}
.wrong-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.wrong-word {
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
  word-break: break-word;
}
.wrong-unit {
  flex: none;
  max-width: 40%;
  color: #77a8ff;
  font-size: 19rpx;
  font-weight: 800;
  text-align: right;
  word-break: break-word;
}
.wrong-ph {
  min-height: 25rpx;
  margin-top: 5rpx;
  color: #778393;
  font-size: 19rpx;
}
.wrong-cn {
  margin-top: 8rpx;
  color: #e9edf2;
  font-size: 24rpx;
  line-height: 1.42;
  font-weight: 800;
}
.wrong-en {
  margin-top: 6rpx;
  color: #a6b0bd;
  font-size: 21rpx;
  line-height: 1.45;
}
.wrong-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.wrong-counts {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.35;
}
.remove-btn {
  width: 92rpx;
  height: 48rpx;
  flex: none;
  border-radius: 6rpx;
  background: #3a2027;
  color: #ff91a4;
  font-size: 19rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-light.wrong-page {
  --bg: #f5f7fa;
  --panel: #fff;
  --line: #d8e0e9;
  --text: #172231;
  --muted: #687789;
  --accent: #3278e6;
}
.theme-light .type-tabs {
  background: #eef2f7;
}
.theme-light .filter-tab.active {
  background: #e5efff;
  color: #215fae;
}
@media (max-width: 340px) {
  .wrong-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
  .practice-actions {
    grid-template-columns: 1fr;
  }
  .wrong-footer {
    align-items: flex-end;
  }
  .wrong-counts {
    min-width: 0;
  }
}
