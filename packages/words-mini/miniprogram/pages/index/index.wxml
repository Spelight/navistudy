<view class="page home">
  <view class="words-header">
    <view class="brand-mark">NW</view>
    <view class="words-brand">
      <text class="words-title">NaviWords</text>
      <text class="words-subtitle">现代大学英语词汇学习</text>
    </view>
    <button class="switch-module" bindtap="goStudy" aria-label="切换 NaviStudy 功能">
      <view class="switch-grid"><view></view><view></view><view></view><view></view></view>
    </button>
  </view>

  <view class="launch-panel">
    <view class="launch-head">
      <view><text class="launch-kicker">当前学习范围</text><text class="launch-title">{{activeBookTitle}}</text></view>
      <text class="launch-progress">{{progressMastered}} / {{progressTotal}}</text>
    </view>

    <scroll-view class="book-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-row">
        <button wx:for="{{books}}" wx:key="id" class="scope-chip {{activeBook===item.id?'active':''}}" data-index="{{index}}" bindtap="selectBook">{{item.shortTitle}}</button>
      </view>
    </scroll-view>
    <scroll-view class="unit-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-row">
        <button wx:for="{{units}}" wx:key="unit" class="unit-chip {{activeUnit==item.unit?'active':''}}" data-index="{{index}}" bindtap="selectUnit">{{item.shortLabel}}</button>
      </view>
    </scroll-view>

    <view class="content-kind-switch" aria-label="选择单词或词组">
      <button class="content-kind-option {{activeKind==='word'?'active':''}}" data-kind="word" bindtap="selectKind">单词</button>
      <button class="content-kind-option {{activeKind==='phrase'?'active':''}}" data-kind="phrase" bindtap="selectKind">词组</button>
    </view>
    <view class="scope-summary"><text>{{activeUnitText}}</text><text>已掌握 {{progressPercent}}%</text></view>
    <view class="progress-track"><view class="progress-value" style="width: {{progressPercent}}%;"></view></view>

    <view class="launch-primary {{!progressTotal ? 'disabled' : ''}}" bindtap="continuePractice" hover-class="action-pressed" aria-role="button" aria-disabled="{{!progressTotal}}">
      <view><text class="launch-primary-title">{{lastProgressText ? '继续背诵' : '开始背诵'}}</text><text class="launch-primary-meta">{{lastProgressText || (progressTotal ? '从当前范围第 1 个' + kindLabel + '开始' : '当前范围暂无' + kindLabel)}}</text></view>
      <view class="forward-arrow"></view>
    </view>
    <view class="mode-grid">
      <button class="mode-button" data-mode="choice" bindtap="startMode"><text class="mode-name">选择</text><text class="mode-note">快速检测</text></button>
      <button class="mode-button" data-mode="spell" bindtap="startMode"><text class="mode-name">拼写</text><text class="mode-note">强化记忆</text></button>
    </view>
  </view>

  <view class="progress-summary">
    <view class="summary-item"><text class="summary-value">{{remainingCount}}</text><text class="summary-label">待学习</text></view>
    <view class="summary-item"><text class="summary-value">{{progressMastered}}</text><text class="summary-label">已掌握</text></view>
    <view class="summary-item"><text class="summary-value risk">{{wrongCount}}</text><text class="summary-label">错题</text></view>
    <view class="summary-item"><text class="summary-value saved">{{favCount}}</text><text class="summary-label">收藏</text></view>
  </view>

  <view class="section-head"><text>专项复习</text><text class="section-link" bindtap="goBooks">查看大纲</text></view>
  <view class="review-list">
    <view class="review-row" bindtap="goWrong" hover-class="row-pressed">
      <view class="review-mark wrong-mark">错</view><view class="review-copy"><text>错题复习</text><text>集中处理当前教材中的薄弱词</text></view><text class="review-count">{{wrongCount}}</text><view class="row-arrow"></view>
    </view>
    <view class="review-row" data-mode="fav-card" bindtap="startMode" hover-class="row-pressed">
      <view class="review-mark fav-mark">藏</view><view class="review-copy"><text>收藏复习</text><text>只看你主动标记的重点内容</text></view><text class="review-count">{{favCount}}</text><view class="row-arrow"></view>
    </view>
  </view>
</view>
