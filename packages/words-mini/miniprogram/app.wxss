page {
  min-height: 100%;
  width: 100%;
  overflow-x: hidden;
  background: #050608;
  color: #f6f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input, scroll-view, picker, navigator, image {
  box-sizing: border-box;
}

button {
  max-width: 100%;
  margin: 0;
  padding: 0;
  line-height: 1.2;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: none;
}

.page {
  width: 100%;
  min-width: 0;
  padding: 28rpx 30rpx 64rpx;
}

.top-title {
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #f7f8fc;
}

.muted {
  color: #969aa5;
}

.panel {
  background: #1c1d20;
  border-radius: 22rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.36);
}

.primary-btn {
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: #2c7be5;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #26282d;
  color: #2c7be5;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.danger-btn {
  background: #3a2027;
  color: #ff6b81;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: #15161a;
  color: #f6f7fb;
  font-size: 29rpx;
}
